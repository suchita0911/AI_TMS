# ============ Application ============
APP_NAME="AI Powered TMS"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============ Database ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tms

# ============ Security / JWT ============
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_super_secret_key_please_rotate
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_SETUP_TOKEN_EXPIRE_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# ============ AI (Claude) ============
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=8192

# ============ File storage ============
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=200

# ============ Frontend ============
FRONTEND_BASE_URL=http://localhost:5173

# ============ Due-date reminders ============
# Background task creates reminder notifications/emails as due dates approach
# (buckets: 7, 5, 3, 1, 0 days before, plus overdue). Idempotent per day.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_INTERVAL_HOURS=12

# ============ Email (SMTP) — required for real email delivery ============
# Leave SMTP_HOST blank to run without email (notifications are still recorded
# in-app and email delivery is marked "skipped").
# Gmail example: create an App Password (Google Account → Security → 2-Step
# Verification → App passwords) and use it as SMTP_PASSWORD.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM="AI TMS <you@gmail.com>"
#   SMTP_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AI TMS <no-reply@tms.local>"
SMTP_TLS=true

# ============ Bootstrap admin (created on first startup) ============
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@tms.local
FIRST_ADMIN_PASSWORD=Admin@12345
