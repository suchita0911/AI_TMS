#!/bin/sh
# Sourced by the nginx image's docker-entrypoint before 20-envsubst-on-templates.sh.
# Populates ${NGINX_LOCAL_RESOLVERS} from the container's /etc/resolv.conf so the
# resolver directive in default.conf.template gets a real DNS server address.
# Falls back to Docker's embedded DNS if resolv.conf has no nameserver.
resolvers="$(awk 'BEGIN{ORS=" "} $1=="nameserver"{print $2}' /etc/resolv.conf)"
export NGINX_LOCAL_RESOLVERS="${resolvers:-127.0.0.11}"
echo "$0: NGINX_LOCAL_RESOLVERS=${NGINX_LOCAL_RESOLVERS}"
